{
  "name": "yatori-panel",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:server": "bun --filter @yatori/server dev",
    "dev:web": "bun --filter @yatori/web dev",
    "typecheck:all": "cd packages/shared && bunx tsc --noEmit && cd ../../apps/server && bunx tsc --noEmit && cd ../web && bunx vue-tsc --noEmit",
    "changelog:preview": "bunx git-cliff --unreleased --strip header",
    "changelog:update": "node scripts/changelog.mjs update",
    "changelog:release": "node scripts/changelog.mjs release",
    "release:check": "node scripts/check-release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "gateway:build": "cd gateway && go build -ldflags \"-s -w\" -o bin/gateway.exe .",
    "gateway:start": "cd gateway && ./bin/gateway.exe"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "git-cliff": "2.14.2",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run typecheck:all",
    "commit-msg": "\"$PWD/node_modules/.bin/commitlint\" --edit \"$1\""
  },
  "trustedDependencies": ["simple-git-hooks"]
}
