# yatori-panel 部署环境变量示例
# Docker Compose 会自动读取同目录的 .env；手动部署请自行 export 或由进程管理器注入。
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，切勿提交真实密钥。

# ---------- 访问锁（线上部署必开） ----------
# 默认 true 防止裸奔；本地临时调试可改 false。
# true 时若数据库尚未设置密码，首次启动会生成随机密码并打印到日志；登录后请立即改密。
PANEL_AUTH_REQUIRED=true
# 会话有效期（小时），默认 24。
PANEL_SESSION_TTL_HOURS=24
# 仅 HTTPS 部署时设为 true；纯 HTTP 必须保持 false，否则浏览器不会回传会话 cookie。
# Caddy 用裸 IP + :443 catch-all 自签证书也算 HTTPS，可设 true（浏览器需信任自签 CA）。
PANEL_COOKIE_SECURE=false
# 仅在可信反向代理之后开启（代理必须覆写 X-Forwarded-For），否则登录限速可被伪造 IP 绕过。
PANEL_TRUST_PROXY=false

# ---------- 网关鉴权（Docker 部署推荐设置） ----------
# 生成：openssl rand -hex 32
# 面板与网关会读取同一个值；为空时网关不校验，仅适合本机回环调试。
# 已有部署首次补充该值无需修改其它配置，两端同步重启后生效。
GATEWAY_TOKEN=
# 浏览器跨域直连网关调试时填写固定 Origin（如 http://localhost:5173）；留空不开放 CORS。
GATEWAY_CORS_ORIGIN=
# 是否允许会话详情返回原始 cookie/token；生产环境必须保持 false。
GATEWAY_DEBUG_SESSION=false

# ---------- 加密密钥（可选，推荐线上注入） ----------
# 生成：openssl rand -base64 32
# 注意：已有账号数据时不要更换密钥，否则旧密码无法解密；
# 已有数据继续使用 data/secret.key 时请保持此项注释。
# PANEL_SECRET_KEY=

# ---------- 跨域白名单（可选，默认仅同源） ----------
# PANEL_CORS_ORIGINS=https://panel.example.com

# ---------- 以下仅供非 Docker 手动部署参考（Compose 已固定容器内取值） ----------
# PANEL_HOST=0.0.0.0
# PANEL_PORT=8080
# GATEWAY_URL=http://127.0.0.1:9801
# PANEL_DATA_DIR=./data
